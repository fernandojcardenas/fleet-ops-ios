rules_version = '2';

// Security rules for Fleet Ops (Rental Fleet Management).
//
// Access model: one company, many staff. A signed-in user may touch fleet
// data only if an allowlist document exists at /staff/{uid}. Clients can
// never write to /staff; it is managed from the Firebase console or the
// Admin SDK. Being signed in is not enough on its own.
//
// Why: the rules deployed until 2026-09 allowed any signed-in account to
// read and write every document. Self sign-up was switched off in Firebase
// Auth, but that left one setting as the only control. These rules add a
// second, independent one. See docs/security/firestore-rules-hardening.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function data() {
      return request.resource.data;
    }

    function vehicleExists(vehicleID) {
      return vehicleID is string
        && exists(/databases/$(database)/documents/vehicles/$(vehicleID));
    }

    // ---- Staff allowlist -------------------------------------------------
    // A user may check their own membership; nobody may write it from a client.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Vehicles ----------------------------------------------------------
    function validVehicle() {
      return data().make is string
        && data().model is string
        && data().year is int
        && data().vin is string
        && data().licensePlate is string
        && data().addedBy is string;
    }

    match /vehicles/{vehicleId} {
      allow read, delete: if isStaff();

      allow create: if isStaff()
        && validVehicle()
        && data().addedBy == request.auth.uid;

      // addedBy records who created the vehicle and may not be rewritten.
      allow update: if isStaff()
        && validVehicle()
        && data().addedBy == resource.data.addedBy;
    }

    // ---- Maintenance logs ----------------------------------------------
    function validLog() {
      return data().vehicleID is string
        && data().serviceType is string
        && data().date is timestamp
        && data().mileage is int
        && data().mileage >= 0
        && data().cost is number
        && data().cost >= 0;
    }

    match /logs/{logId} {
      allow read, delete: if isStaff();
      allow create: if isStaff() && validLog() && vehicleExists(data().vehicleID);
      allow update: if isStaff() && validLog();
    }

    // ---- Trips -------------------------------------------------------------
    function validTrip() {
      return data().vehicleID is string
        && data().status in ['Active', 'Completed'];
    }

    match /trips/{tripId} {
      allow read, delete: if isStaff();
      allow create: if isStaff() && validTrip() && vehicleExists(data().vehicleID);
      allow update: if isStaff() && validTrip();
    }

    // ---- Service templates -----------------------------------------------
    function validTemplate() {
      return data().serviceName is string
        && data().mileageInterval is int
        && data().mileageInterval > 0
        && data().assignedVehicleIDs is list;
    }

    match /serviceTemplates/{templateId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validTemplate();
    }

    // ---- Per-user records ------------------------------------------------
    // Account deletion removes /users/{uid}; each user touches only their own.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---- Everything else is denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
