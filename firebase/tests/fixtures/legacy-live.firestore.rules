rules_version = '2';
// The Firestore rules that were live in production from 2026-05-14 until the
// 2026-09 hardening, copied from the Firebase console on 2026-09-27.
// Kept only so tests/legacy.test.mjs can demonstrate the weakness.
// Never deploy this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
