xcuserdata/
*.xcuserstate
*.xcuserstatebreakpoints
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode - build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Xcode - legacy project metadata
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
# Package.resolved is committed so CI builds use the exact SDK versions that shipped.

# CocoaPods (not currently used)
Pods/

# Carthage (not currently used)
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output

# Misc
*.log
*.swp
*~

# Local workspace symlinks (Xcode Info.plist alias at repo root)
/Fleet-Maintenance-Tracker-Info.plist

# Firebase app config: per-environment, never committed.
# Production copy lives only on the release Mac; see docs/setup.md.
GoogleService-Info.plist

# Firebase tooling (firebase/)
firebase/node_modules/
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
